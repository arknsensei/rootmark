{
  "id": "C2-10",
  "title": "Provenance of events: change and delete events of an attributed ingest carry meta.actor and meta.source; events without them replay; malformed or unpaired values are rejected when the vault is opened (spec \u00a77, 1.0.3)",
  "kind": "governance",
  "matcher": {
    "version": "v3",
    "theta": 0.5,
    "theta_split": 0.65
  },
  "ops": [
    {
      "op": "ingest",
      "doc": "a.md",
      "file": "../C1-08/v0.md",
      "author": "human",
      "source": "editor"
    },
    {
      "op": "ingest",
      "doc": "a.md",
      "file": "../C1-08/v1.md",
      "author": "agent",
      "source": "conformance-agent/1.0",
      "actor": "agent:conformance-agent/1.0"
    },
    {
      "op": "ingest",
      "doc": "a.md",
      "file": "../C1-08/v2.md",
      "author": "agent",
      "source": "conformance-agent/1.0",
      "actor": "agent:conformance-agent/1.0"
    },
    {
      "op": "ingest",
      "doc": "b.md",
      "file": "../C1-10/t0.md",
      "author": "human",
      "source": "editor"
    },
    {
      "op": "ingest",
      "doc": "b.md",
      "file": "../C1-10/t1.md",
      "author": "agent",
      "source": "conformance-agent/1.0",
      "actor": "agent:conformance-agent/1.0"
    },
    {
      "op": "ingest",
      "doc": "c.md",
      "file": "../C1-11/t0.md",
      "author": "human",
      "source": "editor"
    },
    {
      "op": "ingest",
      "doc": "c.md",
      "file": "../C1-11/t1.md",
      "author": "agent",
      "source": "conformance-agent/1.0",
      "actor": "agent:conformance-agent/1.0"
    },
    {
      "op": "ingest",
      "doc": "d.md",
      "file": "../C1-12/v0.md",
      "author": "human",
      "source": "editor"
    },
    {
      "op": "ingest",
      "doc": "d.md",
      "file": "../C1-12/v1.md",
      "author": "agent",
      "source": "conformance-agent/1.0",
      "actor": "agent:conformance-agent/1.0"
    },
    {
      "op": "ingest",
      "doc": "e.md",
      "file": "../C1-14/v0.md",
      "author": "human",
      "source": "editor"
    },
    {
      "op": "ingest",
      "doc": "e.md",
      "file": "../C1-14/v1.md",
      "author": "agent",
      "source": "conformance-agent/1.0",
      "actor": "agent:conformance-agent/1.0"
    },
    {
      "op": "ingest",
      "doc": "e.md",
      "file": "../C1-14/v2.md",
      "author": "agent",
      "source": "conformance-agent/1.0",
      "actor": "agent:conformance-agent/1.0"
    },
    {
      "op": "ingest",
      "doc": "e.md",
      "file": "../C1-14/v3.md",
      "author": "agent",
      "source": "conformance-agent/1.0",
      "actor": "agent:conformance-agent/1.0"
    },
    {
      "op": "events"
    },
    {
      "op": "actor_tamper",
      "kind": "BlockDeleted",
      "change": "remove_both"
    },
    {
      "op": "actor_tamper",
      "kind": "BlockDeleted",
      "change": "remove_actor",
      "expect_open_err": "meta.actor and meta.source go together"
    },
    {
      "op": "actor_tamper",
      "kind": "BlockUpdated",
      "change": "actor_kind",
      "expect_open_err": "malformed meta.actor"
    },
    {
      "op": "actor_tamper",
      "kind": "BlockSplit",
      "change": "actor_id_empty",
      "expect_open_err": "meta.actor.id is empty"
    },
    {
      "op": "actor_tamper",
      "kind": "BlockMerged",
      "change": "actor_extra_field",
      "expect_open_err": "malformed meta.actor"
    },
    {
      "op": "actor_tamper",
      "kind": "BlockMoved",
      "change": "source_number",
      "expect_open_err": "meta.source is not a string"
    },
    {
      "op": "actor_tamper",
      "kind": "BlockCreated",
      "change": "add_both",
      "expect_open_err": "carries no meta.actor/meta.source"
    },
    {
      "op": "layers"
    }
  ]
}
