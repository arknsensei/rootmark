# Homebrew formula draft for rootmark (P1-E/E5; filled by scripts/release.sh).
# Not submitted anywhere: publishing is a human step (docs/RELEASE.md).
class Rootmark < Formula
  desc "Block-level lineage, provenance and deterministic derived index for Markdown"
  homepage "https://github.com/arknsensei/rootmark"
  version "@VERSION@"
  license "Apache-2.0"

  on_macos do
    on_arm do
      url "https://github.com/arknsensei/rootmark/releases/download/v@VERSION@/rootmark-@VERSION@-aarch64-apple-darwin.tar.gz"
      sha256 "@SHA256_AARCH64_APPLE_DARWIN@"
    end
  end

  def install
    bin.install "rootmark"
    pkgshare.install "models"
  end

  def caveats
    <<~EOS
      Search needs the embedder model files once:
        #{pkgshare}/models/fetch_model.sh #{pkgshare}
      and ROOTMARK_MODELS=#{pkgshare}/models
    EOS
  end

  test do
    assert_match "rootmark #{version}", shell_output("#{bin}/rootmark --version")
  end
end
