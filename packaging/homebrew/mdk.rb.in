# Homebrew formula draft for mdk (P1-E/E5; filled by scripts/release.sh).
# Not submitted anywhere: publishing is a human step (docs/RELEASE.md).
class Mdk < Formula
  desc "Block-level lineage, provenance and deterministic derived index for Markdown"
  homepage "https://github.com/<owner>/mdkernel"
  version "@VERSION@"
  license "Apache-2.0"

  on_macos do
    on_arm do
      url "https://github.com/<owner>/mdkernel/releases/download/v@VERSION@/mdk-@VERSION@-aarch64-apple-darwin.tar.gz"
      sha256 "@SHA256_AARCH64_APPLE_DARWIN@"
    end
  end

  def install
    bin.install "mdk"
    pkgshare.install "models"
  end

  def caveats
    <<~EOS
      Search needs the embedder model files once:
        #{pkgshare}/models/fetch_model.sh #{pkgshare}
      and MDK_MODELS=#{pkgshare}/models
    EOS
  end

  test do
    assert_match "mdk #{version}", shell_output("#{bin}/mdk --version")
  end
end
