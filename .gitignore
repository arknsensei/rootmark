# build
/target/
.venv/
__pycache__/
*.pyc
*.so
.pytest_cache/
.ruff_cache/
node_modules/

# secrets
.env

# research data: everything ignored except manifests, the API-generated question set and splits
/research/data/*
!/research/data/MANIFEST.*.json
!/research/data/d4/
!/research/data/splits/
# reference data for the Rust index (P1-C C1, C2; generated by research/eval/gen_*_ref.py)
!/research/data/embed_ref.json
!/research/data/tok_ref.json
# Rust quality regression reference (P1-C.1 C1-9, K-C1.2; research/eval/gen_quality_ref.py)
!/research/data/quality_ref_rust.json

# research run outputs (local; reference runs and round reports are committed explicitly)
/research/reports/runs/*
!/research/reports/runs/.gitkeep
# P1-C determinism vaults (D3 copies, ~70 MB; make p1c-checks)
/research/reports/p1c_work/
!/research/reports/runs/20261013T154851Z-f133d0b/
!/research/reports/runs/20261013T182004Z-f82dabd/

# conformance output (written by `make conformance`)
/reports/conformance.json
/reports/conformance_l1.json

# test scratch vaults
**/fixtures/**/.rootmark/
# the P1-E.1 old-index fixture is a vault with its .rootmark/ (scripts/gen_old_index.sh)
!/server/tests/fixtures/index_v2/vault/.rootmark/

# macOS
.DS_Store

# embedder model files (scripts/fetch_model.sh; pinned by models/MANIFEST.json)
/models/*
!/models/MANIFEST.json
dist/
