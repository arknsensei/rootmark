{
  "name": "rootmark-obsidian",
  "version": "0.2.0",
  "private": true,
  "description": "Obsidian client of rootmark serve: blame, proposals, promote, search, checkpoints, traces over the HTTP contract (docs/CLIENT_CONTRACT.md)",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "test": "vitest run",
    "lint": "tsc --noEmit && eslint .",
    "e2e": "node e2e/build.mjs && node e2e/.build/run.mjs",
    "e2e:real": "node e2e/real/build.mjs && node e2e/real/.build/run.mjs"
  },
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "obsidian": "1.14.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
