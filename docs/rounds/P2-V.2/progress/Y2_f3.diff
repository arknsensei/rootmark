+def _summary_p2v2(rows: list[dict], reps: int, inv: dict) -> dict:
+    """P2-V.2's reading (K-P2V1.2 T5): P2-V.1's, with the `reported_only`
+    real-Obsidian O criteria reported outside the verdict, and every row
+    saying whether it is in the verdict."""
+    reading = inv["mac_reading"]
+    single = {c["criterion"] for c in reading.get("single_run", [])}
+    hist = {c["criterion"]: c for c in reading.get("historical", [])}
+    ro = {c["criterion"]: c for c in reading["reported_only"]}
+    sets = []
+    for s in inv["mac_sets"]:
+        crit = []
+        for c in s["criteria"]:
+            key = f"{c['file']}:{c['criterion']}"
+            src = rows[:1] if key in single else rows
+            vals = [r["criteria"][key] for r in src if key in r["criteria"]]
+            if len(vals) != len(src):
+                raise KeyError(f"{key}: missing from a repetition")
+            if c.get("threshold") is None:
+                same = None
+                if all("logs" in v for v in vals):
+                    same = all(v["logs"] == vals[0]["logs"] for v in vals)
+                crit.append(
+                    {
+                        "criterion": key,
+                        "threshold": None,
+                        "eşik yok": c.get("why_no_threshold"),
+                        "equal_across_reps": same,
+                        "values": vals,
+                        "in_verdict": False,
+                        "pass": None,
+                    }
+                )
+                continue
+            passes = [v.get("pass") is True for v in vals]
+            row = {
+                "criterion": key,
+                "threshold": c["threshold"],
+                "source": c["source"],
+                "runs": len(vals),
+                "passed": f"{sum(passes)}/{len(vals)}",
+                "values": vals,
+                "pass_3of3": all(passes) and len(vals) == 3 if key not in single else None,
+            }
+            if key in hist:
+                # by record equality (P2-V.1); in the verdict when single-run
+                row |= _historical(key, vals[0], hist[key])
+                row["pass"] = None
+                row["in_verdict"] = key in single
+            elif key in single:
+                row["pass"] = all(passes)
+                row["in_verdict"] = True
+            elif key in ro:
+                row["reported_only"] = {
+                    "carry": ro[key]["carry"],
+                    "decision": ro[key]["decision"],
+                }
+                row["pass"] = None  # K-P2V1.2 T5: values and threshold reported
+                row["in_verdict"] = False
+            elif s["class"] == "Z":
+                row["pass"] = None  # K-P2V.3: Z thresholds are not the verdict's
+                row["in_verdict"] = False
+            else:
+                row["pass"] = row["pass_3of3"]  # the other O criteria: 3/3
+                row["in_verdict"] = True
+            crit.append(row)
+        held = [
+            (x["record_equal"] if x["criterion"] in hist else x["pass"])
+            for x in crit
+            if x["in_verdict"]
+        ]
+        sets.append(
+            {
+                "id": s["id"],
+                "class": s["class"],
+                "criteria": crit,
+                "pass": all(held) if held else None,
+                "pass_3of3": all(
+                    x.get("pass_3of3") for x in crit if x.get("pass_3of3") is not None
+                ),
+            }
+        )
+    rows_all = [x for s in sets for x in s["criteria"]]
+    verdict = [
+        (x["record_equal"] if x["criterion"] in hist else x["pass"])
+        for x in rows_all
+        if x["in_verdict"]
+    ]
+    return {
+        "reps": reps,
+        "reading": "P2-V.2 mac_reading (K-P2V.3 T2 (b)+(c), K-P2V1.2 T5)",
+        "rep_runs": [r["run"] for r in rows],
+        "rep_elapsed_s": [r["elapsed_s"] for r in rows],
+        "sets": sets,
+        "criteria": sorted({c["criterion"] for c in rows_all}),
+        "no_threshold": sorted(c["criterion"] for c in rows_all if c["threshold"] is None),
+        "single_run": sorted(single),
+        "historical": {
+            c["criterion"]: c.get("record_equal") for c in rows_all if c["criterion"] in hist
+        },
+        "in_verdict": sorted(c["criterion"] for c in rows_all if c["in_verdict"]),
+        "reported_only": [
+            {
+                "criterion": x["criterion"],
+                "threshold": x["threshold"],
+                "source": x["source"],
+                "passed": x["passed"],
+                "carry": ro[x["criterion"]]["carry"],
+                "in_verdict": False,
+            }
+            for x in rows_all
+            if x["criterion"] in ro
+        ],
+        "pass": bool(verdict) and all(verdict) and reps == 3,
+    }
+
+
+def rows_of(rec: dict) -> list[dict]:
+    """The repetitions of a recorded `mac_checks.json`, rebuilt from its
+    per-criterion values (P2-V.2/F3 `reread`): the values exactly as
+    recorded, a single-run criterion in repetition 1 only."""
+    reps = rec["reps"]
+    rows = [
+        {"run": r, "elapsed_s": e, "criteria": {}}
+        for r, e in zip(rec["rep_runs"], rec["rep_elapsed_s"], strict=True)
+    ]
+    if len(rows) != reps:
+        raise KeyError(f"{reps} repetitions, {len(rows)} runs recorded")
+    single = set(rec.get("single_run", []))
+    for s in rec["sets"]:
+        for c in s["criteria"]:
+            key, vals = c["criterion"], c["values"]
+            idx = [0] if key in single else list(range(reps))
+            if len(vals) != len(idx):
+                raise KeyError(f"{key}: {len(vals)} values for {len(idx)} repetitions")
+            for i, v in zip(idx, vals, strict=True):
+                prev = rows[i]["criteria"].get(key)
+                if prev is not None and prev != v:
+                    raise KeyError(f"{key}: two values in repetition {i + 1}")
+                rows[i]["criteria"][key] = v
+    return rows
+
+
+def reread(rec: dict, inv: dict) -> dict:
+    res = summary_rows(rows_of(rec), rec["reps"], inv)
+    res |= {k: rec[k] for k in ("elapsed_s", "setup_s", "total_s")}
+    return res
+
+
+def values_equal(rec: dict, res: dict) -> dict:
+    """Per criterion: the reread's values byte for byte the record's."""
+
+    def vals(doc):
+        return {c["criterion"]: dump_json(c["values"]) for s in doc["sets"] for c in s["criteria"]}
+
+    a, b = vals(rec), vals(res)
+    eq = {k: a.get(k) == b.get(k) for k in sorted(set(a) | set(b))}
+    return {
+        "criteria": len(eq),
+        "equal": sum(eq.values()),
+        "per_criterion": eq,
+        "pass": all(eq.values()),
+    }
+
+
