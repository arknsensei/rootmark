> def _own_field(cid: str, path: str) -> str:
>     """A classifier path of criterion `cid`'s record (`/`-joined keys) as a
>     comparator key of its file (`cid›…`, dots as `·`)."""
>     return "›".join(p.replace(".", "·") for p in [cid, *path.split("/")])
