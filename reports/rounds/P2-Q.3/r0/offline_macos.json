{
 "probe": "D-0/R5 supplement: changes made while the server is down",
 "platform": "macos",
 "machine": "arm64",
 "rootmark_version": "rootmark 0.3.2",
 "parameters": {
  "gap_before_restart_s": 5.0,
  "settle_s": 10.0,
  "reps": 3
 },
