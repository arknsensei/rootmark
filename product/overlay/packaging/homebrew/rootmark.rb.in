# Homebrew formula template for RootMark. The release workflow
# (.github/workflows/release.yml, job `tap`) fills @VERSION@ and the two
# archives' sha256 from the published SHA256SUMS and opens a pull request to
# rootmark-ai/homebrew-tap (`brew install rootmark-ai/tap/rootmark`).
class Rootmark < Formula
  desc "Block-level lineage, provenance and deterministic derived index for Markdown"
  homepage "https://docs.rootmark.ai/"
  version "@VERSION@"
  license "Apache-2.0"

  on_macos do
    on_arm do
      url "https://github.com/rootmark-ai/rootmark/releases/download/v@VERSION@/rootmark-@VERSION@-aarch64-apple-darwin.tar.gz"
      sha256 "@SHA256_AARCH64_APPLE_DARWIN@"
    end
  end

  on_linux do
    on_intel do
      url "https://github.com/rootmark-ai/rootmark/releases/download/v@VERSION@/rootmark-@VERSION@-x86_64-unknown-linux-gnu.tar.gz"
      sha256 "@SHA256_X86_64_UNKNOWN_LINUX_GNU@"
    end
  end

  def install
    bin.install "rootmark"
    pkgshare.install "models"
    doc.install "LICENSE", "NOTICE", "THIRD_PARTY_LICENSES", "README.md"
  end

  def caveats
    <<~EOS
      Search and the server need the embedder model files once:
        #{pkgshare}/models/fetch_model.sh #{pkgshare}
      and then:
        export ROOTMARK_MODELS=#{pkgshare}/models
    EOS
  end

  test do
    assert_equal "rootmark #{version}", shell_output("#{bin}/rootmark --version").strip
    assert_match(/\A\d+\.\d+\.\d+\Z/, shell_output("#{bin}/rootmark --spec-version").strip)
    # `rootmark conformance` (39/39) needs the model files: after the caveats' fetch
  end
end
