# Copied into a scratch workspace next to `git archive v3-final core` by
# scripts/gen_v3final_mixed.sh; never built inside this repository's workspace.
[package]
name = "rootmark-v3final-mixed-gen"
version = "0.0.0"
edition = "2021"
publish = false

[dependencies]
anyhow = "1.0.104"
# the v3-final crate keeps its name (K-GH.1); the code says `rootmarkcore`
rootmarkcore = { package = "mdkernel-core", path = "../core" }
serde_json = "1.0.154"
